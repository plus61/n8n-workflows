FROM python:3.11-slim

# ffmpegとフォントのインストール（エラーハンドリング強化版）
RUN set -ex && \
    echo "=== Starting package installation ===" && \
    apt-get update && \
    echo "=== Installing ffmpeg and libmagic ===" && \
    apt-get install -y ffmpeg libmagic1 fontconfig && \
    echo "=== Installing Noto fonts ===" && \
    apt-get install -y \
    fonts-noto-cjk \
    fonts-noto-cjk-extra \
    fonts-noto-color-emoji \
    fonts-noto-core && \
    echo "=== CRITICAL: Verifying font package installation ===" && \
    dpkg -l | grep fonts-noto || (echo "ERROR: fonts-noto packages not installed!" && exit 1) && \
    echo "=== SUCCESS: Font packages installed ===" && \
    dpkg -l | grep fonts-noto && \
    echo "=== Updating font cache with fc-cache -fv ===" && \
    fc-cache -fv && \
    echo "=== Verifying font directories exist ===" && \
    ls -la /usr/share/fonts/truetype/noto/ || (echo "ERROR: Noto truetype directory not found!" && exit 1) && \
    echo "=== SUCCESS: Font installation verified ===" && \
    ls -la /usr/share/fonts/truetype/noto/ && \
    rm -rf /var/lib/apt/lists/*

# Python依存関係（FastAPIサーバー用）
COPY requirements-server.txt /app/
WORKDIR /app
RUN pip install --no-cache-dir -r requirements-server.txt

# アプリケーションコピー
COPY render_server.py /app/
COPY render_video_ffmpeg.py /app/
COPY phase4c_ffmpeg_concat.py /app/
COPY templates/ /app/templates/

# 実行権限
RUN chmod +x /app/render_server.py /app/render_video_ffmpeg.py

# ポート公開
EXPOSE 8000

# FastAPIサーバー起動
ENTRYPOINT ["python3", "/app/render_server.py"]

