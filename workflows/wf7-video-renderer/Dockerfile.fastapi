FROM python:3.11-slim

# ffmpegとフォントのインストール（診断出力追加 + fc-cache実行）
RUN echo "=== Starting package installation ===" && \
    apt-get update && \
    echo "=== Installing packages ===" && \
    apt-get install -y \
    ffmpeg \
    libmagic1 \
    fontconfig \
    fonts-noto-cjk \
    fonts-noto-cjk-extra \
    fonts-noto-color-emoji \
    fonts-noto-core && \
    echo "=== Verifying font installation ===" && \
    dpkg -l | grep fonts-noto && \
    echo "=== Updating font cache (fc-cache -fv) ===" && \
    fc-cache -fv && \
    echo "=== Listing font directories ===" && \
    ls -la /usr/share/fonts/ || echo "Font directory not found" && \
    ls -la /usr/share/fonts/truetype/ || echo "Truetype directory not found" && \
    ls -la /usr/share/fonts/truetype/noto/ || echo "Noto directory not found" && \
    echo "=== Font installation complete ===" && \
    rm -rf /var/lib/apt/lists/*

# Python依存関係（FastAPIサーバー用）
COPY requirements-server.txt /app/
WORKDIR /app
RUN pip install --no-cache-dir -r requirements-server.txt

# アプリケーションコピー
COPY render_server.py /app/
COPY render_video_ffmpeg.py /app/
COPY phase4c_ffmpeg_concat.py /app/
COPY templates/ /app/templates/

# 実行権限
RUN chmod +x /app/render_server.py /app/render_video_ffmpeg.py

# ポート公開
EXPOSE 8000

# FastAPIサーバー起動
ENTRYPOINT ["python3", "/app/render_server.py"]

