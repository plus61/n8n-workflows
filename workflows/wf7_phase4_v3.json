    {
      "parameters": {
        "jsCode": "const notionPage = $input.first().json;\nconst props = notionPage.properties;\n\n// URL型プロパティまたはrich_text型プロパティから取得を試みる\n// 1. Script JSON: URL型プロパティ → Script URL → rich_text型プロパティの順で試す\nlet scriptJsonUrl = props['Script JSON']?.url\n  || props['Script URL']?.url\n  || null;\n\nlet scriptJsonText = null;\nif (!scriptJsonUrl) {\n  // rich_text型から直接取得\n  const scriptJsonRichText = props['Script JSON']?.rich_text?.[0]?.text?.content;\n  if (scriptJsonRichText) {\n    scriptJsonText = scriptJsonRichText;\n  } else {\n    throw new Error('Script JSON not found in Notion page properties (tried: Script JSON.url, Script URL.url, Script JSON.rich_text)');\n  }\n}\n\n// 2. Assets JSON: URL型プロパティ → Assets URL → rich_text型プロパティの順で試す\nlet assetsJsonUrl = props['Assets JSON']?.url\n  || props['Assets URL']?.url\n  || null;\n\nlet assetsJsonText = null;\nif (!assetsJsonUrl) {\n  // rich_text型から直接取得\n  const assetsJsonRichText = props['Assets JSON']?.rich_text?.[0]?.text?.content;\n  if (assetsJsonRichText) {\n    assetsJsonText = assetsJsonRichText;\n  } else {\n    throw new Error('Assets JSON not found in Notion page properties (tried: Assets JSON.url, Assets URL.url, Assets JSON.rich_text)');\n  }\n}\n\n// Article ID取得\nconst articleId = props['Article ID']?.rich_text?.[0]?.text?.content\n  || props['Article ID']?.url\n  || notionPage.id;\n\n// URLがある場合はURLを返し、rich_textから直接取得した場合はテキストを返す\nif (scriptJsonUrl && assetsJsonUrl) {\n  // 両方URL型の場合\n  return {\n    json: {\n      notionPageId: notionPage.id,\n      articleId,\n      scriptJsonUrl,\n      assetsJsonUrl,\n      useUrl: true\n    }\n  };\n} else if (scriptJsonText && assetsJsonText) {\n  // 両方rich_text型の場合\n  return {\n    json: {\n      notionPageId: notionPage.id,\n      articleId,\n      scriptJsonText,\n      assetsJsonText,\n      useUrl: false\n    }\n  };\n} else {\n  throw new Error('Mixed data types: Script JSON and Assets JSON must both be URL or both be rich_text');\n}"
      },
