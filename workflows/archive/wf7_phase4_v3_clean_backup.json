cript JSON.rich_text)');\n  }\n}\n\n// 2. Assets JSON: URL型プロパティ → Assets URL → rich_text型プロパティの順で試す\nlet assetsJsonUrl = props['Assets JSON']?.url\n  || props['Assets URL']?.url\n  || null;\n\nlet assetsJsonText = null;\nif (!assetsJsonUrl) {\n  // rich_text型から直接取得\n  const assetsJsonRichText = props['Assets JSON']?.rich_text?.[0]?.text?.content;\n  if (assetsJsonRichText) {\n    assetsJsonText = assetsJsonRichText;\n  } else {\n    throw new Error('Assets JSON not found in Notion page properties (tried: Assets JSON.url, Assets URL.url, Assets JSON.rich_text)');\n  }\n}\n\n// Article ID取得\nconst articleId = props['Article ID']?.rich_text?.[0]?.text?.content\n  || props['Article ID']?.url\n  || notionPage.id;\n\n// URLがある場合はURLを返し、rich_textから直接取得した場合はテキストを返す\nif (scriptJsonUrl && assetsJsonUrl) {\n  // 両方URL型の場合\n  return {\n    json: {\n      notionPageId: notionPage.id,\n      articleId,\n      scriptJsonUrl,\n      assetsJsonUrl,\n      useUrl: true\n    }\n  };\n} else if (scriptJsonText && assetsJsonText) {\n  // 両方rich_text型の場合\n  return {\n    json: {\n      notionPageId: notionPage.id,\n      articleId,\n      scriptJsonText,\n      assetsJsonText,\n      useUrl: false\n    }\n  };\n} else {\n  throw new Error('Mixed data types: Script JSON and Assets JSON must both be URL or both be rich_text');\n}"},"id":"d2c59e5f-b5af-434c-885b-fa2ed344247f","name":"URL抽出","type":"n8n-nodes-base.code","typeVersion":2,"position":[-3600,-128]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"check-useurl","leftValue":"={{ $json.useUrl }}","rightValue":true,"operator":{"type":"boolean","operation":"equals"}}],"combinator":"and"},"options":{}},"id":"49ef8a3c-939d-4cd3-b250-3b9dc0a05c3f","name":"URL型チェック","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[-3376,-128]},{"parameters":{"url":"={{ $json.scriptJsonUrl }}","options":{"response":{"response":{"responseFormat":"text"}}}},"id":"