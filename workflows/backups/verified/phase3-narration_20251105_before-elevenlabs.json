  "name": "WF7 Phase3: 音声・字幕生成(オプション)",
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wf7-phase3-audio",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "382d69ca-acd3-4206-bd95-2a0efa4d82f2",
      "name": "WF7-Phase3 Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [-1024, 64],
      "webhookId": "wf7-phase3-audio-webhook",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.body?.needsNarration || $json.needsNarration }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "b3f7b709-f6e0-4be1-a42c-4147b8dd96b1",
      "name": "音声必要性判定",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-800, 64]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst body = input.body?.body || input.body || input;\n\nconst articleId = body.articleId;\nconst notionPageId = body.notionPageId;\nconst scriptUrl = body.scriptUrl;\n\nif (!articleId || !notionPageId) {\n  throw new Error('articleId and notionPageId are required');\n}\n\n// TODO: scriptUrlからscript.jsonを取得してnarrationTextを抽出\nconst narrationText = 'こちらの動画では、MEO対策の基本を紹介します。';\n\nreturn {\n  json: {\n    articleId,\n    notionPageId,\n    narrationText\n  }\n};"
      },
      "id": "dcf62300-0c4b-4889-abcf-b11060c43946",
      "name": "ナレーション抽出",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-608, 16]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/audio/speech",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.OPENAI_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"model\": \"tts-1\",\n  \"input\": $json.narrationText,\n  \"voice\": \"nova\",\n  \"response_format\": \"wav\"\n} }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          },
          "timeout": 30000
        }
      },
      "id": "0ec0d8ad-a6bd-4d0d-bbe0-e8153f1424b6",
      "name": "OpenAI TTS音声生成",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-400, 16]
    },
    {
      "parameters": {
        "fileName": "={{ '/tmp/voice_' + $('ナレーション抽出').first().json.articleId + '.wav' }}",
        "options": {}
      },
      "id": "9a0908dd-abeb-45b3-83b7-802584867aba",
      "name": "音声ファイル保存",
      "type": "n8n-nodes-base.writeBinaryFile",
      "typeVersion": 1,
      "position": [-208, 16]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const articleId = $('ナレーション抽出').first().json.articleId;\nconst notionPageId = $('ナレーション抽出').first().json.notionPageId;\nconst baseUrl = $env.N8N_HOST || 'https://n8n-python-production-344b.up.railway.app';\nconst fullBaseUrl = baseUrl.startsWith('http') ? baseUrl : `https://${baseUrl}`;\n\n// Webhook経由でファイル配信URLを生成（クエリパラメータ方式）\nconst voiceFileUrl = `${fullBaseUrl}/webhook/wf7-files-audio?articleId=${articleId}`;\n\nreturn {\n  json: {\n    articleId,\n    notionPageId,\n    voiceFileUrl,\n    voiceFileName: `voice_${articleId}.wav`\n  }\n};"
      },
      "id": "08a4623b-56e6-4cad-8b3e-c45057d8876e",
      "name": "音声メタデータ保存",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "const narrationText = $('ナレーション抽出').first().json.narrationText;\nconst articleId = $('ナレーション抽出').first().json.articleId;\n\nconst srtContent = `1\\n00:00:00,000 --> 00:00:05,000\\n${narrationText.substring(0,50)}\\n\\n2\\n00:00:05,000 --> 00:00:10,000\\n${narrationText.substring(50)}\\n`;\n\n// SRTコンテンツをバイナリに変換\nconst buffer = Buffer.from(srtContent, 'utf8');\n\nreturn {\n  json: {\n    ...$json,\n    srtFileName: `subtitle_${articleId}.srt`\n  },\n  binary: {\n    data: {\n      data: buffer.toString('base64'),\n      mimeType: 'text/plain',\n      fileName: `subtitle_${articleId}.srt`\n    }\n  }\n};"
      },
      "id": "189a2fb4-a5d3-4c07-9ada-77aa8e39a2bf",
      "name": "SRT字幕生成",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [192, 0]
    },
    {
      "parameters": {
        "fileName": "={{ '/tmp/subtitle_' + $('ナレーション抽出').first().json.articleId + '.srt' }}",
        "options": {}
      },
      "id": "933b8547-1944-44a8-9849-8712dd49b68f",
      "name": "字幕ファイル保存",
      "type": "n8n-nodes-base.writeBinaryFile",
      "typeVersion": 1,
      "position": [400, 16]
    },
    {
      "parameters": {
        "jsCode": "const prevData = $input.first().json;\nconst articleId = $('ナレーション抽出').first().json.articleId;\nconst baseUrl = $env.N8N_HOST || 'https://n8n-python-production-344b.up.railway.app';\nconst fullBaseUrl = baseUrl.startsWith('http') ? baseUrl : `https://${baseUrl}`;\n\n// Webhook経由でファイル配信URLを生成（クエリパラメータ方式）\nconst subtitleFileUrl = `${fullBaseUrl}/webhook/wf7-files-subtitle?articleId=${articleId}`;\n\nreturn {\n  json: {\n    ...prevData,\n    subtitleFileUrl,\n    subtitleFileName: `subtitle_${articleId}.srt`\n  }\n};"
      },
      "id": "32344475-3f6e-44e5-b449-136adf3f609a",
      "name": "字幕メタデータ保存",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [592, 16]
    },
    {
      "parameters": {
        "jsCode": "const { notionPageId, voiceFileUrl, subtitleFileUrl } = $input.first().json;\n\nif (!notionPageId) {\n  throw new Error('notionPageId is required');\n}\n\nreturn {\n  json: {\n    notionPageId,\n    notionPayload: {\n      properties: {\n        'Voice URL': {url: voiceFileUrl || ''},\n        'Subtitle URL': {url: subtitleFileUrl || ''},\n        'Status': {select: {name: 'VoiceReady'}}\n      }\n    }\n  }\n};"
      },
      "id": "db641470-3012-4ed5-b543-9e8882957bc5",
      "name": "Notionペイロード作成",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [800, 16]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://api.notion.com/v1/pages/{{ $json.notionPageId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.NOTION_API_TOKEN }}"
            },
            {
              "name": "Notion-Version",
              "value": "2022-06-28"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.notionPayload }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "676722ee-294c-4932-8e13-239fc53ff5fd",
      "name": "Notionページ更新",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [992, 16]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {status: 'success', message: 'WF7 Phase3 completed', articleId: $('ナレーション抽出').first().json.articleId, notionPageId: $('ナレーション抽出').first().json.notionPageId, voiceFileUrl: $('音声メタデータ保存').first().json.voiceFileUrl, subtitleFileUrl: $('字幕メタデータ保存').first().json.subtitleFileUrl} }}",
        "options": {}
      },
      "id": "5c176c26-8c97-4b96-886d-cd041f04d4f2",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [1200, 16],
      "onError": "continueRegularOutput"
    }
  ],
