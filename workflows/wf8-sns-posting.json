      "id": "prepare-facebook",
      "name": "Facebook投稿準備",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1120, 420]
    },
    {
      "parameters": {
        "jsCode": "// TODO: Twitter API v2統合\n// 必要な認証情報:\n// - API Key\n// - API Secret\n// - Access Token\n// - Access Token Secret\n\nconst caption = $json.caption;\nconst videoUrl = $json.videoUrl;\n\nreturn {\n  json: {\n    platform: 'twitter',\n    status: 'pending',\n    message: 'Twitter API未実装 - 手動投稿が必要です',\n    caption: caption,\n    videoUrl: videoUrl\n  }\n};"
      },
      "id": "twitter-post",
      "name": "Twitter投稿 (TODO)",
      "type": "n8n-nodes-base.code",
