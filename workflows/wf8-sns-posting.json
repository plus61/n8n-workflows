{
  "name": "WF8: SNS投稿自動化",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wf8-sns-posting",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger-wf8",
      "name": "WF8-SNS投稿 Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [240, 300],
      "webhookId": "wf8-sns-posting-webhook"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst body = input.body || input;\n\nconst articleId = body.articleId;\nconst notionPageId = body.notionPageId;\nconst title = body.title;\nconst videoUrl = body.videoUrl;\nconst thumbUrl = body.thumbUrl;\n\nif (!articleId || !videoUrl || !title) {\n  throw new Error('articleId, videoUrl, and title are required');\n}\n\nreturn {\n  json: {\n    articleId,\n    notionPageId,\n    title,\n    videoUrl,\n    thumbUrl: thumbUrl || '',\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "id": "input-parse-wf8",
      "name": "入力データ解析",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.OPENAI_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"model\": \"gpt-4\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"あなたはSNS投稿の専門家です。動画タイトルから魅力的な投稿文を3パターン作成してください。1) Twitter/X用(280文字以内、ハッシュタグ3-5個)、2) LinkedIn用(400文字以内、プロフェッショナル)、3) Facebook用(200文字以内、親しみやすい)。JSON形式で返してください: {twitter: string, linkedin: string, facebook: string}\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"動画タイトル: \" + $json.title + \"\\n\\n動画URL: \" + $json.videoUrl\n    }\n  ],\n  \"temperature\": 0.7,\n  \"response_format\": { \"type\": \"json_object\" }\n} }}",
        "options": {}
      },
      "id": "ai-caption-generation",
      "name": "AI Caption Generation (GPT-4)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst prevData = $('入力データ解析').first().json;\n\nlet captions;\ntry {\n  const content = response.choices[0].message.content;\n  captions = JSON.parse(content);\n} catch (error) {\n  // Fallback captions\n  captions = {\n    twitter: `${prevData.title} 🎬\\n\\n動画をチェック👇\\n${prevData.videoUrl}\\n\\n#動画 #AI #自動化`,\n    linkedin: `新しい動画を公開しました！\\n\\n${prevData.title}\\n\\nぜひご覧ください: ${prevData.videoUrl}`,\n    facebook: `${prevData.title}\\n\\n詳しくはこちら: ${prevData.videoUrl}`\n  };\n}\n\nreturn {\n  json: {\n    ...prevData,\n    captions: captions\n  }\n};"
      },
      "id": "caption-parse",
      "name": "Caption Parsing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "platform-twitter",
              "name": "platform",
              "value": "twitter",
              "type": "string"
            },
            {
              "id": "caption-twitter",
              "name": "caption",
              "value": "={{ $json.captions.twitter }}",
              "type": "string"
            },
            {
              "id": "video-url",
              "name": "videoUrl",
              "value": "={{ $json.videoUrl }}",
              "type": "string"
            },
            {
              "id": "article-id",
