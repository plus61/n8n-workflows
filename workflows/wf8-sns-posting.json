      "position": [1340, 180]
    },
    {
      "parameters": {
        "jsCode": "// TODO: LinkedIn API統合\n// 必要な認証情報:\n// - OAuth 2.0 Access Token\n// - Person/Organization URN\n\nconst caption = $json.caption;\nconst videoUrl = $json.videoUrl;\n\nreturn {\n  json: {\n    platform: 'linkedin',\n    status: 'pending',\n    message: 'LinkedIn API未実装 - 手動投稿が必要です',\n    caption: caption,\n    videoUrl: videoUrl\n  }\n};"
      },
      "id": "linkedin-post",
      "name": "LinkedIn投稿 (TODO)",
      "type": "n8n-nodes-base.code",
