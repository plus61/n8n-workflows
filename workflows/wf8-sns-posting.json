    {
      "parameters": {
        "mode": "mergeByIndex",
        "options": {}
      },
      "id": "merge-results",
      "name": "投稿結果マージ",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [1560, 300]
    },
    {
      "parameters": {
        "jsCode": "const results = $input.all().map(item => item.json);\nconst originalData = $('Caption Parsing').first().json;\n\nconst summary = {\n  articleId: originalData.articleId,\n  notionPageId: originalData.notionPageId,\n  timestamp: new Date().toISOString(),\n  platforms: results.map(r => ({\n    platform: r.platform,\n    status: r.status,\n    message: r.message,\n    caption: r.caption\n  }))\n};\n\nreturn {\n  json: summary\n};"
      },
      "id": "summary-creation",
      "name": "投稿サマリー作成",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1780, 300]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://api.notion.com/v1/pages/{{ $('入力データ解析').first().json.notionPageId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.NOTION_API_TOKEN }}"
            },
            {
              "name": "Notion-Version",
              "value": "2022-06-28"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"properties\": {\n    \"Status\": {\n      \"select\": {\n        \"name\": \"SNS Posted\"\n      }\n    },\n    \"Posted Platforms\": {\n      \"multi_select\": $json.platforms.map(p => ({ name: p.platform }))\n    }\n  }\n} }}",
        "options": {}
      },
      "id": "notion-update",
      "name": "Notion投稿記録更新",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 300]
    },
