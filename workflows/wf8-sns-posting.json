    {
      "parameters": {
        "jsCode": "// TODO: Facebook Graph API統合\n// 必要な認証情報:\n// - Page Access Token\n// - Page ID\n\nconst caption = $json.caption;\nconst videoUrl = $json.videoUrl;\n\nreturn {\n  json: {\n    platform: 'facebook',\n    status: 'pending',\n    message: 'Facebook API未実装 - 手動投稿が必要です',\n    caption: caption,\n    videoUrl: videoUrl\n  }\n};"
      },
      "id": "facebook-post",
      "name": "Facebook投稿 (TODO)",
