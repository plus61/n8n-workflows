    {
      "parameters": {
        "jsCode": "// Phase4b学習: 優先順位付きURL抽出\nconst statusResponse = $input.first().json;\nconst resultData = statusResponse.result || statusResponse.data || {};\nconst prepareNode = $('Code - Prepare FAL FFmpeg Payload').first().json;\n\n// 優先順位1: video?.url（Phase4bで最も信頼性が高い）\nlet videoUrl = resultData.video?.url;\n\n// 優先順位2: outputs配列\nif (!videoUrl) {\n  videoUrl = resultData.outputs?.[0];\n}\n\n// 優先順位3: 直接のvideo_url\nif (!videoUrl) {\n  videoUrl = resultData.video_url || statusResponse.video_url;\n}\n\nif (!videoUrl) {\n  throw new Error('Failed to extract video URL from FAL response');\n}\n\nreturn {\n  json: {\n    success: true,\n    script_id: prepareNode.script_id,\n    final_video_url: videoUrl,\n    total_duration: prepareNode.total_duration,\n    video_count: prepareNode.video_count,\n    status: 'COMPLETED'\n  }\n};"
      },
      "id": "code-extract-video-url",
      "name": "Code - Extract Video URL & Build Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
