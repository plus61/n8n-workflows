    {
      "parameters": {
        "jsCode": "// Phase4c: FAL FFmpeg API用 tracks形式ペイロード準備\nconst input = $input.first().json;\nconst videosMetadata = input.videos_metadata || [];\nconst scriptId = input.script_id || input.notionPageId || 'unknown';\n\nif (!Array.isArray(videosMetadata) || videosMetadata.length === 0) {\n  throw new Error('videos_metadata array is required and must not be empty');\n}\n\n// Phase4b学習: 累積時間でkeyframes配置\nlet cumulativeTime = 0;\nconst keyframes = videosMetadata.map((video, index) => {\n  const duration = video.duration || 5;\n  const timestamp = cumulativeTime;\n  cumulativeTime += duration;\n  \n  return {\n    url: video.video_url,\n    timestamp: timestamp,\n    duration: duration\n  };\n});\n\nconst payload = {\n  tracks: [{\n    id: \"1\",\n    type: \"video\",\n    keyframes: keyframes\n  }]\n};\n\nreturn {\n  json: {\n    fal_payload: payload,\n    script_id: scriptId,\n    total_duration: cumulativeTime,\n    video_count: videosMetadata.length\n  }\n};"
      },
      "id": "code-prepare-payload",
      "name": "Code - Prepare FAL FFmpeg Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        464,
        304
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://queue.fal.run/fal-ai/ffmpeg-api/compose",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
