      "id": "b58f2184-b644-4285-88d5-a85220e1c1f1",
      "name": "Notion API呼び出し",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [464, 240],
      "credentials": {
        "notionApi": {
          "id": "y89xQdP2gCTcdyup",
          "name": "Notion account"
        }
      }
