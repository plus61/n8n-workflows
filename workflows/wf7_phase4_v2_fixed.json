              "responseFormat": "text"
            }
          }
        }
      },
      "id": "script-json-fetch-v2",
      "name": "Script JSON取得",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-1850, 112]
    },
    {
      "parameters": {
