    {
      "parameters": {
        "jsCode": "// FAL APIのstatusレスポンスから結果を抽出\nconst statusResponse = $input.first().json;\n\n// FAL APIの結果はstatusレスポンスのoutputフィールドに含まれる\nconst output = statusResponse.output || statusResponse.result || statusResponse;\n\n// video_urlを抽出（複数の可能な場所をチェック）\nconst videoUrl = output.video_url \n  || output.video \n  || output.url \n  || statusResponse.video_url\n  || statusResponse.video;\n\nif (!videoUrl) {\n  throw new Error('Video URL not found in FAL API response. Response: ' + JSON.stringify(statusResponse));\n}\n\nreturn {\n  json: {\n    video_url: videoUrl,\n    raw_response: statusResponse\n  }\n};"
      },
