            }
          }
        }
      },
      "id": "get-result-node",
      "name": "HTTP Request - Get Result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "voV5kURaCkiUjLTZ",
          "name": "fal"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const resultData = $input.first().json;\nconst slideData = $('Code - Prepare FAL Payload').item.json.slide_metadata;\nconst requestId = $('HTTP Request - Submit to FAL').item.json.request_id;\nconst slideIndex = $('Code - Prepare FAL Payload').item.json.slide_index;\n\n// video_url抽出\nconst videoUrl = resultData.output?.video_url \n  || resultData.video_url \n  || resultData.result?.video_url;\n\nif (!videoUrl) {\n  throw new Error('Video URL not found in FAL API response');\n}\n\n// videos_metadataオブジェクト構築\nreturn {\n  json: {\n    section: slideData.section,\n    duration: slideData.duration,\n    video_url: videoUrl,\n    fal_request_id: requestId,\n    motion_prompt: slideData.motion_prompt,\n    filename: `video_${slideIndex + 1}_${slideData.section}.mp4`,\n    text: slideData.text,\n    slide_index: slideIndex\n  }\n};"
      },
      "id": "build-video-metadata-node",
      "name": "Code - Build Video Metadata",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2220, 200]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "retry-count",
              "name": "retry_count",
              "value": "={{ $json.retry_count ? $json.retry_count + 1 : 1 }}",
              "type": "number"
            },
            {
              "id": "status-url",
              "name": "status_url",
              "value": "={{ $json.status_url }}",
              "type": "string"
            },
            {
              "id": "request-id",
              "name": "request_id",
              "value": "={{ $('HTTP Request - Submit to FAL').item.json.request_id }}",
              "type": "string"
            },
            {
              "id": "slide-metadata",
              "name": "slide_metadata",
              "value": "={{ $('Code - Prepare FAL Payload').item.json.slide_metadata }}",
              "type": "object"
            },
            {
              "id": "response-url",
              "name": "response_url",
              "value": "={{ $('HTTP Request - Submit to FAL').item.json.response_url }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "retry-counter-node",
      "name": "Set - Retry Counter",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [2000, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "check-retry-limit",
              "leftValue": "={{ $json.retry_count }}",
              "rightValue": 10,
              "operator": {
                "type": "number",
                "operation": "smaller"
              }
            }
          ]
        }
      },
      "id": "check-retry-limit-node",
      "name": "IF - Check Retry Limit",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [2220, 400]
    },
    {
      "parameters": {
        "resume": "timeInterval",
        "amount": 5,
        "unit": "seconds"
      },
      "id": "wait-before-retry-node",
      "name": "Wait - Before Retry",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [2440, 300],
      "webhookId": "phase4b-retry-wait"
    },
    {
      "parameters": {
        "jsCode": "const slide = $input.first().json.slide_metadata;\nconst retryCount = $input.first().json.retry_count;\n\nreturn {\n  json: {\n    success: false,\n    error: `Rendering timeout for ${slide.section} after ${retryCount} retries`,\n    section: slide.section,\n    retry_count: retryCount\n  }\n};"
      },
      "id": "timeout-error-node",
      "name": "Code - Timeout Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2440, 500]
    },
    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\nconst scriptId = $('Code - Validate Input').item.json.script_id;\n\n// videos_metadata配列を構築（sectionの順序でソート）\nconst sectionOrder = ['hook', 'intro', 'point1', 'point2', 'point3', 'summary', 'cta'];\n\nconst videosMetadata = allItems\n  .map(item => item.json)\n  .sort((a, b) => {\n    return sectionOrder.indexOf(a.section) - sectionOrder.indexOf(b.section);\n  });\n\nreturn {\n  json: {\n    success: true,\n    script_id: scriptId,\n    videos_metadata: videosMetadata,\n    videos_count: videosMetadata.length,\n    total_duration: videosMetadata.reduce((sum, v) => sum + v.duration, 0)\n  }\n};"
      },
      "id": "build-final-response-node",
      "name": "Code - Build Final Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2660, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "respond-webhook-node",
      "name": "Respond to Webhook - Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [2880, 200]
    }
  ],
