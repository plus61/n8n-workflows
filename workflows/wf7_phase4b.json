{
  "name": "WF7 Phase4b - Image to Video",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wf7-phase4b-image-to-video",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-phase4b-start",
      "name": "Webhook - Phase 4b Start",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [240, 300],
      "webhookId": "wf7-phase4b-start",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nif (!input.script_id) {\n  throw new Error('script_id is required');\n}\n\nif (!input.slides_metadata || input.slides_metadata.length !== 7) {\n  throw new Error('slides_metadata must contain exactly 7 items');\n}\n\n// 各スライドの必須フィールド確認\nfor (const slide of input.slides_metadata) {\n  if (!slide.image_url) throw new Error(`Missing image_url for ${slide.section}`);\n  if (!slide.duration) throw new Error(`Missing duration for ${slide.section}`);\n  if (!slide.motion_prompt) throw new Error(`Missing motion_prompt for ${slide.section}`);\n}\n\nreturn input;"
      },
      "id": "validate-input-node",
      "name": "Code - Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "slides_metadata",
        "options": {}
      },
      "id": "split-slides-node",
      "name": "Split Out - Slides",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "// 現在処理中のスライド\nconst slide = $input.first().json;\nconst scriptId = $('Code - Validate Input').item.json.script_id;\n\n// FAL Compose APIペイロード構築\nconst payload = {\n  tracks: [\n    {\n      id: \"1\",\n      type: \"video\",\n      keyframes: [\n        {\n          url: slide.image_url,\n          timestamp: 0,\n          duration: slide.duration\n        }\n      ]\n    }\n  ]\n};\n\nreturn {\n  json: {\n    fal_payload: JSON.stringify(payload),\n    slide_metadata: slide,\n    script_id: scriptId,\n    slide_index: $itemIndex\n  }\n};"
      },
      "id": "prepare-fal-payload-node",
      "name": "Code - Prepare FAL Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://queue.fal.run/fal-ai/ffmpeg-api/compose",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.fal_payload }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 30000
        }
      },
      "id": "submit-to-fal-node",
      "name": "HTTP Request - Submit to FAL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "voV5kURaCkiUjLTZ",
          "name": "fal"
        }
      }
    },
    {
      "parameters": {
        "resume": "timeInterval",
        "amount": 5,
        "unit": "seconds"
      },
      "id": "wait-5s-node",
      "name": "Wait - 5 Seconds",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1340, 300],
      "webhookId": "phase4b-wait-5s"
    },
    {
      "parameters": {
        "method": "GET",
