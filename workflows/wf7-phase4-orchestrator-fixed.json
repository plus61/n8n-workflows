    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// リトライカウントをインクリメント\nconst currentData = $input.first().json;\nconst retryCount = (currentData.retry_count || 0) + 1;\n\nreturn [\n  {\n    json: {\n      ...currentData,\n      retry_count: retryCount,\n      wait_seconds: Math.min(20 * Math.pow(1.5, retryCount - 1), 60)\n    }\n  }\n];"
      },
      "id": "code-increment-retry",
      "name": "Code - Increment Retry Count",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        42,
        448
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "retry-check",
              "leftValue": "={{ $json.retry_count }}",
              "rightValue": "={{ $json.max_retries }}",
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ]
        },
        "options": {
          "onError": "continueRegularOutput"
        }
      },
      "id": "if-max-retries",
