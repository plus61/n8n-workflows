    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Phase4bのレスポンスを保持しつつリトライカウンターを初期化\nconst phase4bData = $input.first().json;\n\nreturn [\n  {\n    json: {\n      ...phase4bData,\n      retry_count: 0,\n      max_retries: 5\n    }\n  }\n];"
      },
