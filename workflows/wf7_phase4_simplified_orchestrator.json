    {
      "parameters": {
        "jsCode": "const notionPage = $input.first().json;\nconst props = notionPage.properties;\n\n// Script JSON取得（URL型またはrich_text型に対応）\nlet scriptJsonUrl = props['Script JSON']?.url || props['Script URL']?.url || null;\nlet scriptJsonText = null;\nif (!scriptJsonUrl) {\n  const scriptJsonRichText = props['Script JSON']?.rich_text?.[0]?.text?.content;\n  if (scriptJsonRichText) {\n    scriptJsonText = scriptJsonRichText;\n  } else {\n    throw new Error('Script JSON not found');\n  }\n}\n\n// Assets JSON取得（URL型またはrich_text型に対応）\nlet assetsJsonUrl = props['Assets JSON']?.url || props['Assets URL']?.url || null;\nlet assetsJsonText = null;\nif (!assetsJsonUrl) {\n  const assetsJsonRichText = props['Assets JSON']?.rich_text?.[0]?.text?.content;\n  if (assetsJsonRichText) {\n    assetsJsonText = assetsJsonRichText;\n  } else {\n    throw new Error('Assets JSON not found');\n  }\n}\n\n// Article ID取得\nconst articleId = props['Article ID']?.rich_text?.[0]?.text?.content || props['Article ID']?.url || notionPage.id;\n\n// URLがある場合はURLを返し、rich_textから直接取得した場合はテキストを返す\nif (scriptJsonUrl && assetsJsonUrl) {\n  return {\n    json: {\n      notionPageId: notionPage.id,\n      articleId,\n      scriptJsonUrl,\n      assetsJsonUrl,\n      useUrl: true,\n      scriptData: null\n    }\n  };\n} else if (scriptJsonText && assetsJsonText) {\n  return {\n    json: {\n      notionPageId: notionPage.id,\n      articleId,\n      scriptJsonText,\n      assetsJsonText,\n      useUrl: false,\n      scriptData: JSON.parse(scriptJsonText)\n    }\n  };\n} else {\n  throw new Error('Mixed data types: Script JSON and Assets JSON must both be URL or both be rich_text');\n}"
      },
