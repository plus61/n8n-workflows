{
  "mcpServers": {
    "n8n-mcp": {
      "command": "/Users/your-username/.nvm/versions/node/v22.20.0/bin/npx",
      "args": ["-y", "n8n-mcp@2.22.11"],
      "env": {
        "N8N_API_URL": "${N8N_API_URL:-https://your-n8n-instance.com}",
        "N8N_API_KEY": "${N8N_API_KEY}",
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true"
      }
    }
  }
}

