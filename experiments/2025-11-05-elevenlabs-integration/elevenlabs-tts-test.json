{
  "name": "ElevenLabs TTS Integration Test",
  "nodes": [
    {
      "parameters": {},
      "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
      "name": "When clicking 'Test workflow'",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "test-script-id",
              "name": "script",
              "value": "これはテストです。ElevenLabsの音声合成をテストしています。高品質な日本語の音声が生成されることを確認します。",
              "type": "string"
            },
            {
              "id": "voice-id-param",
              "name": "voiceId",
              "value": "21m00Tcm4TlvDq8ikWAM",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
      "name": "Prepare Test Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.elevenlabs.io/v1/text-to-speech/{{ $json.voiceId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "xi-api-key",
              "value": "={{ $credentials.elevenlabsApi.apiKey }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"text\": $json.script, \"model_id\": \"eleven_multilingual_v2\", \"voice_settings\": { \"stability\": 0.5, \"similarity_boost\": 0.75 } } }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "audioData"
            }
          }
        }
      },
      "id": "c3d4e5f6-a7b8-9012-cdef-123456789012",
      "name": "Convert Script to Audio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [650, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "elevenlabsApi",
          "name": "ElevenLabs API"
        }
      }
    },
    {
      "parameters": {
        "mode": "jsonToBinary",
        "convertAllData": false,
        "sourceKey": "audioData",
        "options": {
          "fileName": "=narration_{{ $now.toFormat('yyyyMMdd_HHmmss') }}.mp3",
          "mimeType": "audio/mpeg"
        }
      },
      "id": "d4e5f6a7-b8c9-0123-def1-234567890123",
      "name": "Convert to Binary",
      "type": "n8n-nodes-base.moveBinaryData",
      "typeVersion": 1.2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "result-status",
              "name": "status",
              "value": "={{ $json.audioData ? 'success' : 'failed' }}",
              "type": "string"
            },
            {
              "id": "result-size",
              "name": "audioSize",
              "value": "={{ $binary.data ? $binary.data.fileSize : 0 }}",
              "type": "number"
            },
            {
              "id": "result-filename",
              "name": "filename",
              "value": "={{ $binary.data ? $binary.data.fileName : 'N/A' }}",
              "type": "string"
            },
            {
              "id": "result-mimetype",
              "name": "mimeType",
              "value": "={{ $binary.data ? $binary.data.mimeType : 'N/A' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "e5f6a7b8-c9d0-1234-ef12-345678901234",
      "name": "Validate Results",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1050, 300]
    }
  ],
  "connections": {
    "When clicking 'Test workflow'": {
      "main": [
        [
          {
            "node": "Prepare Test Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Test Data": {
      "main": [
        [
          {
            "node": "Convert Script to Audio",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Convert Script to Audio": {
      "main": [
        [
          {
            "node": "Convert to Binary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Convert to Binary": {
      "main": [
        [
          {
            "node": "Validate Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [],
  "triggerCount": 0,
  "updatedAt": "2025-11-05T00:00:00.000Z",
  "versionId": "test-v1"
}
