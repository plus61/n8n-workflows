  "error_handling": {
    "save_video_request_failure": {
      "impact": "Sheets記録失敗だが、ワークフロー継続可能",
      "recommendation": "continueOnFail: true 設定推奨"
    },
    "update_video_record_failure": {
      "impact": "video_url記録失敗、手動補完が必要",
      "recovery": "task_idでレコード検索し、Poll Video StatusノードのvideoUrlを手動入力"
    },
    "matching_column_not_found": {
      "cause": "Save Video Requestが実行されていない、またはtask_idが一致しない",
      "solution": "Save Video Requestの実行確認、task_id式の検証"
    }
  },
  "mcp_template_reference": {
    "source_template": "Generate AI Viral Videos with Seedance and Upload to TikTok, YouTube & Instagram",
    "template_views": 214907,
    "complexity": "medium",
    "learned_patterns": [
      "append操作で初期記録、update操作で完了時更新（2段階記録）",
      "matchingColumnsで既存レコード特定（idやideaカラム）",
      "mappingMode: defineBelow でカラムマッピング明示",
      "schema配列でカラム定義（type, displayName, canBeUsedToMatch）",
      "タイムスタンプは $now.toISO() で記録",
      "クロスノード参照は $('NodeName').first().json.field で取得"
      ]
  }
}
