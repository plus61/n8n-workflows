{
  "name": "WF10-Main: kie.ai Sora 2 ビデオ生成（Google Drive版・修正版）",
  "nodes": [
    {
      "parameters": {
        "event": "pageAddedToDatabase",
        "databaseId": {
          "__rl": true,
          "mode": "id",
          "value": "2b368d5c29868175957ff890b8b27e93"
        },
        "simple": true
      },
      "id": "notion-trigger",
      "name": "Notion Trigger",
      "type": "n8n-nodes-base.notionTrigger",
      "typeVersion": 1,
      "position": [250, 300],
      "credentials": {
        "notionApi": {
          "id": "y89xQdP2gCTcdyup",
          "name": "Notion account"
        }
      }
    },
    {
      "parameters": {
        "resource": "page",
        "operation": "get",
        "pageId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.id }}"
        },
        "simple": true
      },
      "id": "get-notion-page",
      "name": "Get Notion Page",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [450, 300],
      "credentials": {
        "notionApi": {
          "id": "y89xQdP2gCTcdyup",
          "name": "Notion account"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.properties.Image_URL }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "download-image",
      "name": "Download Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "operation": "upload",
        "name": "={{ $json.fileName || 'image_' + Date.now() + '.jpg' }}",
        "inputDataFieldName": "data",
        "options": {
          "parents": {
            "parentId": ""
          }
        }
      },
      "id": "upload-to-google-drive",
      "name": "Upload to Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [850, 300],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "plniYONxQ1iPNoAi",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "operation": "share",
        "fileId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.id }}"
        },
        "permissionsInput": "defineRolePermissions",
        "role": "reader",
        "type": "anyone"
      },
      "id": "share-file",
      "name": "Share File",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [1050, 300],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "plniYONxQ1iPNoAi",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "image-direct-url",
              "name": "image_direct_url",
              "value": "=https://drive.google.com/uc?export=view&id={{ $json.id }}",
              "type": "string"
            },
            {
              "id": "google-drive-id",
              "name": "google_drive_id",
              "value": "={{ $json.id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "create-direct-link",
      "name": "Create Direct Link",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.kie.ai/api/v1/jobs/createTask",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.KIE_AI_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"model\": \"sora-2-image-to-video\",\n  \"input\": {\n    \"prompt\": $('Get Notion Page').item.json.properties.Prompt || \"高品質な動画を生成してください\",\n    \"image_urls\": [$json.image_direct_url],\n    \"aspect_ratio\": \"portrait\",\n    \"quality\": \"hd\",\n    \"duration\": 10\n  }\n} }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "create-video-task",
      "name": "Create Video Task",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1450, 300]
    },
    {
      "parameters": {
        "unit": "seconds",
        "amount": 30
      },
      "id": "wait-30s",
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1650, 300],
      "webhookId": ""
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.kie.ai/api/v1/jobs/getStatus?job_id={{ $('Create Video Task').item.json.job_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.KIE_AI_API_KEY }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "get-status",
      "name": "Get Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1850, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "status-completed",
              "leftValue": "={{ $json.status }}",
              "rightValue": "completed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-status",
      "name": "Check Status",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2050, 300]
    },
    {
      "parameters": {},
      "id": "loop-back",
      "name": "Loop",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [2250, 450]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "video-url",
              "name": "video_url",
              "value": "={{ $json.output.video_url }}",
              "type": "string"
            },
            {
              "id": "notion-page-id",
              "name": "notion_page_id",
              "value": "={{ $('Notion Trigger').item.json.id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "extract-video-url",
      "name": "Extract Video URL",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [2250, 150]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "update",
        "pageId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.notion_page_id }}"
        },
        "propertiesUi": {
          "propertyValues": [
            {
              "key": "Video_URL",
              "urlValue": "={{ $json.video_url }}"
            },
            {
              "key": "Status",
              "selectValue": "Completed"
            }
          ]
        }
      },
      "id": "update-notion",
      "name": "Update Notion",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [2450, 150],
      "credentials": {
        "notionApi": {
          "id": "y89xQdP2gCTcdyup",
          "name": "Notion account"
        }
      }
    }
  ],
