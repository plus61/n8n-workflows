            }
          ]
        },
        "options": {}
      },
      "id": "set-test-data",
      "name": "Set - Test Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ \"https://drive.google.com/uc?export=download&id=\" + $json.google_drive_file_id }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          },
          "timeout": 30000
        }
      },
      "id": "http-download-image",
      "name": "HTTP Request - Download Image from Google Drive",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Google Driveからダウンロードした画像をBase64 Data URIに変換\nconst binaryData = $input.first().binary.data;\n\nif (!binaryData) {\n  throw new Error('No binary data found');\n}\n\n// バイナリデータをBase64エンコード\nconst base64Data = binaryData.data;\n\n// MIMEタイプを取得（デフォルトはimage/png）\nconst mimeType = binaryData.mimeType || 'image/png';\n\n// Data URI形式に変換\nconst dataUri = `data:${mimeType};base64,${base64Data}`;\n\n// 台本本文も取得\nconst prompt = $('Set - Test Data').first().json.台本本文;\n\nreturn {\n  image_data_uri: dataUri,\n  prompt: prompt,\n  original_mime_type: mimeType,\n  data_size_kb: Math.round(base64Data.length / 1024)\n};"
      },
      "id": "code-convert-base64",
      "name": "Code - Convert to Base64 Data URI",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://queue.fal.run/fal-ai/runway-gen3/turbo/image-to-video?fal_webhook=https://n8n-python-production-344b.up.railway.app/webhook/wf10-runway-webhook",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"image_url\": $json.image_data_uri,\n  \"prompt\": $json.prompt,\n  \"duration\": 10,\n  \"ratio\": \"16:9\"\n} }}"
      },
      "id": "http-request-runway",
      "name": "HTTP Request - Runway Gen-3 API (Base64)",
