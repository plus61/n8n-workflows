    {
      "parameters": {
        "jsCode": "// 画像URLを取得\nlet imageUrl = $json.画像素材URL[0];\n\n// Google Drive URLの場合、API v3形式に変換\nif (imageUrl.includes('drive.google.com')) {\n  // FILE_IDを抽出（2つのパターンに対応）\n  // パターン1: ?id=FILE_ID または &id=FILE_ID\n  // パターン2: /d/FILE_ID/\n  const fileIdMatch = imageUrl.match(/[?&]id=([^&]+)/) || imageUrl.match(/\\/d\\/([^\\/]+)/);\n  \n  if (fileIdMatch && fileIdMatch[1]) {\n    const fileId = fileIdMatch[1];\n    // Google Drive API v3形式に変換（公開ファイルの直接アクセス）\n    imageUrl = `https://www.googleapis.com/drive/v3/files/${fileId}?alt=media`;\n  }\n}\n\n// 変換後のURLと台本を返す\nreturn {\n  画像素材URL: [imageUrl],\n  台本本文: $json.台本本文\n};"
      },
      "id": "code-convert-url",
      "name": "Code - Convert Google Drive URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://queue.fal.run/fal-ai/runway-gen3/turbo/image-to-video?fal_webhook=https://n8n-python-production-344b.up.railway.app/webhook/wf10-runway-webhook",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"image_url\": $json.画像素材URL[0],\n  \"prompt\": $json.台本本文,\n  \"duration\": 10,\n  \"ratio\": \"16:9\"\n} }}"
      },
      "id": "http-request-runway",
