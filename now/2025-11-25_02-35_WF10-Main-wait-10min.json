{
  "name": "WF10-Main: kie.ai Sora 2 ビデオ生成(Webhook Manual Trigger版)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wf10-notion-trigger",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [256, 304],
      "webhookId": "wf10-notion-trigger"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "page-id-extract",
              "name": "id",
              "value": "={{ $json.body.page_id || $json.query.page_id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "extract-page-id",
      "name": "Extract Page ID",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [464, 304]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "get",
        "pageId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.id }}"
        }
      },
      "id": "get-notion-page",
      "name": "Get Notion Page",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [656, 304],
      "credentials": {
        "notionApi": {
          "id": "y89xQdP2gCTcdyup",
          "name": "Notion account"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $json.property_image_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "download-image",
      "name": "Download Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [864, 304]
    },
    {
      "parameters": {
        "name": "={{ $json.fileName || 'image_' + Date.now() + '.jpg' }}",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "mode": "list",
          "value": "root",
          "cachedResultName": "/ (Root folder)"
        },
        "options": {}
      },
      "id": "upload-to-google-drive",
      "name": "Upload to Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [1056, 304],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "plniYONxQ1iPNoAi",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "operation": "share",
        "fileId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.id }}"
        },
        "permissionsUi": {
          "permissionsValues": {
            "role": "reader",
            "type": "anyone"
          }
        },
        "options": {}
      },
      "id": "share-file",
      "name": "Share File",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [1264, 304],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "plniYONxQ1iPNoAi",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "image-direct-url",
              "name": "image_direct_url",
              "value": "={{ $('Upload to Google Drive').item.json.webContentLink }}",
              "type": "string"
            },
            {
              "id": "google-drive-id",
              "name": "google_drive_id",
              "value": "={{ $('Upload to Google Drive').item.json.id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "create-direct-link",
      "name": "Create Direct Link",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1456, 304]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.kie.ai/api/v1/jobs/createTask",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.KIE_AI_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"model\": \"sora-2-image-to-video\",\n  \"input\": {\n    \"prompt\": $('Get Notion Page').item.json.property_prompt || \"高品質な動画を生成してください\",\n    \"image_urls\": [$json.image_direct_url],\n    \"aspect_ratio\": \"portrait\",\n    \"quality\": \"hd\",\n    \"duration\": 10\n  }\n} }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "create-video-task",
      "name": "Create Video Task",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1664, 304]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Create Video TaskノードからtaskIdを取得してJSONレスポンスを構築\nconst createVideoTaskData = $('Create Video Task').item.json;\n\nreturn {\n  json: {\n    success: true,\n    message: \"Video generation started\",\n    taskId: createVideoTaskData.data.taskId,\n    status: \"processing\",\n    estimatedTime: \"4-5 minutes\"\n  }\n};"
      },
      "id": "build-response-json",
      "name": "Build Response JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1744, 48]
    },
    {
      "parameters": {
        "amount": 600
      },
      "id": "wait-30s",
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1856, 304],
      "webhookId": "ec5ff8bd-5074-40bf-b352-eb01037a8d90"
    },
    {
      "parameters": {
        "url": "=https://api.kie.ai/api/v1/veo/record-info?taskId={{ $('Create Video Task').item.json.data.taskId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.KIE_AI_API_KEY }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "get-status",
      "name": "Get Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2064, 272]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "status-completed",
              "leftValue": "= ={{ $json.data.state }}",
              "rightValue": "success",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-status",
      "name": "Check Status",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2256, 304]
    },
    {
      "parameters": {},
      "id": "loop-back",
      "name": "Loop",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [2464, 464]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "video-url",
              "name": "video_url",
              "value": "={{ JSON.parse($json.data.resultJson).resultUrls[0] }}",
              "type": "string"
            },
            {
              "id": "notion-page-id",
              "name": "notion_page_id",
              "value": "={{ $('Extract Page ID').item.json.id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "extract-video-url",
      "name": "Extract Video URL",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [2464, 160]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "update",
        "pageId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.notion_page_id }}"
        },
        "propertiesUi": {
          "propertyValues": [
            {
              "key": "Video_URL",
              "urlValue": "={{ $json.video_url }}"
            },
            {
              "key": "Status",
              "selectValue": "Completed"
            }
          ]
        },
        "options": {}
      },
      "id": "update-notion",
      "name": "Update Notion",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [2688, 160],
      "credentials": {
        "notionApi": {
          "id": "y89xQdP2gCTcdyup",
          "name": "Notion account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [1824, 48],
      "id": "84a63b13-c451-4548-bcd6-a52b80360f02",
      "name": "Respond to Webhook"
    }
  ],
