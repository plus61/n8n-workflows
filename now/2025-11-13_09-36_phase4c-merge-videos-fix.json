    {
      "parameters": {
        "jsCode": "// Phase4c: FAL merge-videos APIレスポンスからvideo.urlを抽出\nconst statusResponse = $input.first().json;\nconst prepareNode = $('Code - Prepare FAL Merge Videos Payload').first().json;\n\n// merge-videos APIは video.url 構造で返す\nconst videoUrl = statusResponse.video?.url;\n\nif (!videoUrl) {\n  throw new Error(`Failed to extract video URL. Response: ${JSON.stringify(statusResponse, null, 2)}`);\n}\n\nreturn {\n  json: {\n    success: true,\n    script_id: prepareNode.script_id,\n    final_video_url: videoUrl,\n    total_duration: prepareNode.total_duration,\n    video_count: prepareNode.video_count,\n    status: 'COMPLETED'\n  }\n};"
      },
