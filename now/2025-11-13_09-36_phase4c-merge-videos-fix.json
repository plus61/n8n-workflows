      "parameters": {
        "jsCode": "// Phase4c: FAL FFmpeg API merge-videos用ペイロード準備\n// ENDPOINT CHANGE: /compose から /merge-videos に変更\nconst input = $input.first().json;\n\n// Webhookからのデータ構造に対応\nconst bodyData = input.body || input;\nconst videosMetadata = bodyData.videos || bodyData.videos_metadata || [];\nconst scriptId = bodyData.pageId || bodyData.script_id || bodyData.notionPageId || 'unknown';\n\nif (!Array.isArray(videosMetadata) || videosMetadata.length < 2) {\n  throw new Error('videos array must contain at least 2 videos');\n}\n\n// merge-videos APIはシンプルなvideo_urls配列のみ必要\nconst video_urls = videosMetadata.map(video => video.url || video.video_url);\n\n// 総尺を計算（メタデータ用）\nconst total_duration = videosMetadata.reduce((sum, video) => sum + (video.duration || 0), 0);\n\nconst payload = {\n  video_urls: video_urls\n};\n\nreturn {\n  json: {\n    fal_payload: payload,\n    script_id: scriptId,\n    total_duration: total_duration,\n    video_count: videosMetadata.length\n  }\n};"
      },
      "id": "1f2817e4-fb13-458a-a5ef-2c0287ac99ee",
      "name": "Code - Prepare FAL Merge Videos Payload",
      "type": "n8n-nodes-base.code",
