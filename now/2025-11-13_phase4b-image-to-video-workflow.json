      },
      "id": "http-get-result",
      "name": "HTTP Request - Get Result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-432, 288],
      "credentials": {
        "httpHeaderAuth": {
          "id": "voV5kURaCkiUjLTZ",
          "name": "fal"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Phase4b: Luma Ray 2 Flash レスポンスから動画URLを抽出\nconst statusResponse = $input.first().json;\nconst prepareNode = $('Code - Prepare Luma Ray 2 Payload').first().json;\n\n// Luma Ray 2 Flash は video.url 構造で返す\nconst videoUrl = statusResponse.video?.url;\n\nif (!videoUrl) {\n  throw new Error(`Failed to extract video URL. Response: ${JSON.stringify(statusResponse, null, 2)}`);\n}\n\nreturn {\n  json: {\n    success: true,\n    script_id: prepareNode.script_id,\n    slide_index: prepareNode.slide_index,\n    video_url: videoUrl,\n    duration: prepareNode.requested_duration,\n    status: 'COMPLETED'\n  }\n};"
      },
      "id": "code-extract-video",
      "name": "Code - Extract Video URL & Build Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-224, 288]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
