{
  "name": "WF7 Phase4b - Image to Video Generator (Luma Ray 2 Flash)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wf7-phase4b-image-to-video",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-phase4b-start",
      "name": "Webhook - Phase4b Start",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [-1984, 400],
      "webhookId": "phase4b-image-to-video-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Phase4b: Luma Ray 2 Flash (Image to Video) ペイロード準備\nconst input = $input.first().json;\n\n// Webhookからのデータ構造に対応\nconst bodyData = input.body || input;\nconst imageUrl = bodyData.image_url || bodyData.url;\nconst prompt = bodyData.prompt || \"教育動画風の動きのある映像\";\nconst duration = bodyData.duration || 5; // 秒数（5 or 9）\nconst scriptId = bodyData.pageId || bodyData.script_id || 'unknown';\nconst slideIndex = bodyData.slide_index || 0;\n\nif (!imageUrl) {\n  throw new Error('image_url is required');\n}\n\n// Luma Ray 2 Flash API用ペイロード\nconst payload = {\n  prompt: prompt,\n  image_url: imageUrl,\n  aspect_ratio: \"16:9\",\n  resolution: \"540p\",  // コスト最適化のため540p\n  duration: duration === 9 ? \"9s\" : \"5s\",\n  loop: false\n};\n\nreturn {\n  json: {\n    fal_payload: payload,\n    script_id: scriptId,\n    slide_index: slideIndex,\n    requested_duration: duration\n  }\n};"
      },
      "id": "code-prepare-payload",
      "name": "Code - Prepare Luma Ray 2 Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1760, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://queue.fal.run/fal-ai/luma-dream-machine/ray-2-flash/image-to-video",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Key {{ $credentials.falApiKey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.fal_payload }}",
        "options": {}
      },
      "id": "http-submit-to-fal",
      "name": "HTTP Request - Submit to FAL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-1536, 400],
      "credentials": {
        "httpHeaderAuth": {
          "id": "voV5kURaCkiUjLTZ",
          "name": "fal"
        }
      }
    },
    {
      "parameters": {
        "amount": 10
      },
      "id": "wait-10s",
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [-1312, 400],
      "webhookId": "phase4b-wait-webhook"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
